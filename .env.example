# LifeOS does not load secrets from environment variables or .env files.
# Per docs/SPEC.md rule 7 / §7 (non-negotiable): every token, password, and
# client secret lives ONLY in macOS Keychain, service "lifeos" — never in a
# file, never in an env var. `lifeos doctor` scans the repo and vault for
# leaked secrets on every run.
#
# This file is a reference checklist, not something to fill in. Provision
# each value with the matching command; nothing here is ever read by the app.
# See PROGRESS.md for the up-to-date status of which of these are done.

# --- Canvas (P1-01) ---
# lifeos secret set canvas_token
# canvas_base_url is NOT a secret; it's set in ~/.config/lifeos/config.toml

# --- BYU Learning Suite (P1-05) — one per course ---
# lifeos secret set ls_feed:<COURSE>          # e.g. ls_feed:IS401

# --- Google Calendar / Gmail (P1-08) ---
# lifeos secret set google_client             # paste the full OAuth client JSON
# lifeos secret set google_token:<account>    # written by `lifeos auth google` once built

# --- iCloud Calendar (P1-10) ---
# lifeos secret set icloud_app_password
# lifeos secret set icloud_apple_id

# --- Outlook: personal and BYU (P1-12) ---
# lifeos secret set outlook_token:personal    # written by `lifeos auth outlook` once built
# lifeos secret set outlook_token:byu

# --- Slack (P2-04) — one per workspace ---
# lifeos secret set slack_token:<workspace>

# --- Shopify: Spiced and Javvas (P3-01, P3-02) ---
# lifeos secret set shopify:spiced:client_id
# lifeos secret set shopify:spiced:client_secret
# lifeos secret set shopify:javvas:client_id
# lifeos secret set shopify:javvas:client_secret
